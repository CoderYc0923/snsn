# Copy to .env and fill in. Do not commit .env.

# Server
SNSN_HOST=0.0.0.0
SNSN_PORT=8000
SNSN_WORKERS=1
SNSN_TMP_DIR=./data/tmp
SNSN_MAX_UPLOAD_MB=200
SNSN_MAX_DURATION_SEC=1800
SNSN_API_TOKEN=
SNSN_APP_PASSWORD=

# Aliyun OSS — use a cn-beijing bucket for Paraformer
SNSN_OSS_ACCESS_KEY_ID=
SNSN_OSS_ACCESS_KEY_SECRET=
SNSN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
SNSN_OSS_INTERNAL_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
SNSN_OSS_BUCKET=
SNSN_OSS_PREFIX=tmp/snsn/
# Leave empty: ASR URL is signed with INTERNAL endpoint (Bailian intranet pull).
# Set only if you must force a custom public base (will incur 外网流出).
SNSN_OSS_PUBLIC_BASE_URL=

# DashScope / Bailian
SNSN_DASHSCOPE_API_KEY=
SNSN_ASR_MODEL=paraformer-v2
SNSN_TRANSLATE_MODEL=qwen-plus
SNSN_ENABLE_TRANSLATE=true
# Speed knobs for long episodes (API-bound; little CPU on box)
SNSN_TRANSLATE_BATCH_ITEMS=10
SNSN_TRANSLATE_BATCH_CHARS=1600
SNSN_TRANSLATE_CONCURRENCY=4
